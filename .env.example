# Copy to .env and fill in. .env is never committed (see .gitignore).
#
# Generate each shared token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Team name reported by every /health response.
LAB1_TEAM=team-tbd

# First port of the claimed block. Subject +0, CSP +1, Verifier +2, RP +3.
LAB1_PORT_BLOCK=4100
# Bind every interface: 127.0.0.1 works on the server and is invisible from campus.
LAB1_BIND_HOST=0.0.0.0

# Shared tokens. Both are required; a service that cannot find its token
# refuses to start rather than falling back to a default.
# CSP -> Verifier, on POST /binding:
LAB1_CSP_BINDING_TOKEN=<paste 32 random characters here>
# RP -> Verifier, on POST /introspect:
LAB1_RP_INTROSPECT_TOKEN=<paste 32 random characters here>

# Assertion and session lifetimes, in seconds.
LAB1_ASSERTION_TTL_SECONDS=60
LAB1_SESSION_TTL_SECONDS=600

# Online-guessing limit on the Verifier: attempts per client address per window.
# Loose on purpose: every service runs on one host, so a tight limit locks out
# the probe and the Subject agent along with an attacker.
LAB1_AUTH_MAX_ATTEMPTS=10
LAB1_AUTH_WINDOW_SECONDS=60

# Refuse a session credential presented from an address it was not issued to.
LAB1_RP_PIN_SESSION_TO_CLIENT=1

# Quieten the per-request access log (used by the test suite).
LAB1_QUIET_LOG=0

# subject and CSP variables
TEAM=hayagreeva-jonathan

HOST=127.0.0.1
SUBJECT_PORT=4000
CSP_PORT=4001
VERIFIER_PORT=4002
RP_PORT=4003

DB_PATH=app.db

EMAIL_USERNAME=
EMAIL_PASSWORD=
